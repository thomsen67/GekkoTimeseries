<Window x:Class="Gekko.WindowDlinkGitHook"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Gekko -- data file sync" Height="440" Width="640" Name="startup"
    WindowStartupLocation="CenterScreen" Closing="Window_Closing">

    <DockPanel>
        <Grid DockPanel.Dock="Bottom" Height="35" Background="WhiteSmoke">
            <Button Name="button1" Width="75" IsDefault="True" Click="button1_Click" IsEnabled="False"
                    HorizontalAlignment="Right" Margin="0,6,9,7">OK</Button>            
        </Grid>

        <Grid DockPanel.Dock="Top" Margin="10,10,10,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Name="progressLabel" Grid.Row="0" Text="Starting..." Foreground="#FF444444"/>
            <ProgressBar Name="progressBar" Grid.Row="2" Height="16" Minimum="0" Maximum="100" Value="0"/>
        </Grid>

        <TextBox Name="textBox1" Margin="10,0,10,10" Padding="10,10,10,10" IsReadOnly="True"
                 TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 AutoWordSelection="True" FontFamily="Courier New" FontSize="11"/>
    </DockPanel>
</Window>
