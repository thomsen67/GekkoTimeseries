<Window x:Class="Gekko.WindowDlinkErrors"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Gekko -- data file errors" Height="440" Width="640" Name="dlinkErrors"
    WindowStartupLocation="CenterScreen">

    <DockPanel>
        <Grid DockPanel.Dock="Bottom" Height="35" Background="WhiteSmoke">
            <Button Name="button1" Width="75" IsDefault="True" IsCancel="True" Click="button1_Click"
                    HorizontalAlignment="Right" Margin="0,6,9,7">OK</Button>
        </Grid>

        <TextBlock Name="headlineLabel" DockPanel.Dock="Top" Margin="10,10,10,6" Text="Errors"
                   Foreground="#FFB00020" FontWeight="SemiBold" TextWrapping="Wrap"/>

        <TextBox Name="textBox1" Margin="10,0,10,10" Padding="10,10,10,10" IsReadOnly="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                 AutoWordSelection="True" FontFamily="Courier New" FontSize="11"/>
    </DockPanel>
</Window>
