<Window x:Class="Gekko.WindowDlink"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dlink files manager (create/update)"
        Height="560" Width="880"
        WindowStartupLocation="CenterScreen">    

    <Window.Resources>        
        <Style x:Key="RoundedSmallButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="18"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="#FFF0F0F0"/>
            <Setter Property="BorderBrush" Value="#FFACACAC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">                      
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFE5E5E5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FFD0D0D0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <ContextMenu x:Key="RowContextMenu">
            <MenuItem Header="Copy data file path" Click="CopyDataFilePath_Click"/>
            <MenuItem Header="Copy dlink file path" Click="CopyDlinkFilePath_Click"/>
            <Separator/>
            <!-- Acts on every currently-selected row, not just the one right-clicked -->
            <MenuItem Header="Delete selected row(s)" Click="DeleteSelectedRows_Click"/>
        </ContextMenu>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Grid Grid.Row="0" Name="DropZone" AllowDrop="True"
              Drop="DropZone_Drop" DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave">
            <Rectangle Name="DropZoneBorder" Fill="#FFF4F4F4" Stroke="#FF999999" StrokeThickness="2"
                       StrokeDashArray="4 2" RadiusX="4" RadiusY="4"/>
            <TextBlock Name="DropZoneHintText" Text="Drag data files or data folders here"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                       FontSize="14" Foreground="#FF555555" TextWrapping="Wrap" TextAlignment="Center" Margin="10"/>
        </Grid>
        
        <DataGrid Grid.Row="2" Name="FilesGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                  IsReadOnly="True" SelectionMode="Extended" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#FF999999" PreviewKeyDown="FilesGrid_PreviewKeyDown"
                  AllowDrop="True" Drop="DropZone_Drop" DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave">            
            <DataGrid.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FFE3E3E3"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FFEAEAEA"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="Black"/>
            </DataGrid.Resources>
            <!-- New: suppresses the per-cell black keyboard-focus rectangle that WPF draws by
                 default (DataGrid always tracks a "current cell" for keyboard nav, even though
                 SelectionUnit is FullRow here) -- the gray row-selection background above is
                 already the only selection indicator we want. -->
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="ContextMenu" Value="{StaticResource RowContextMenu}"/>
                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="Row_PreviewMouseRightButtonDown"/>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>                
                <!-- New: SortMemberPath lets the user click this header to sort by data file path,
                     since DataGrid cannot auto-detect a sort key for a template column. -->
                <DataGridTemplateColumn Header="Path" Width="*" SortMemberPath="Path" CanUserSort="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical" Margin="2,6,2,6">                
                                <TextBlock Text="{Binding Path}" Foreground="#FF1F4E79"/>
                                <TextBlock Text="{Binding DlinkPathDisplay}" Foreground="#FF888888"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- New: MB column. Bound to the unrounded SizeMB (StringFormat only affects the
                     displayed text), so sorting -- CanUserSort is on by default here, since this is
                     a plain Binding, unlike the Path column above -- compares actual size, not the
                     rounded/formatted string. -->
                <DataGridTextColumn Header="MB" Binding="{Binding SizeMB, StringFormat={}{0:F1}}" Width="70">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="Margin" Value="0,0,8,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="150"/>                
                <DataGridTemplateColumn Header="" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Dlink" Style="{StaticResource RoundedSmallButtonStyle}"
                                        Margin="0,0,4,0" Click="DlinkSingleRow_Click" Tag="{Binding}"/>
                                <Button Content="Remove" Style="{StaticResource RoundedSmallButtonStyle}"
                                        Click="RemoveRow_Click" Tag="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        
        <!-- New: two "lines" -- StatusText (transient progress/status messages, including the full
             data file path while processing) on top, and a permanent "Files = ..." count plus the
             action buttons on the bottom. -->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Name="StatusText" Grid.Row="0" Foreground="#FF444444" TextTrimming="CharacterEllipsis"/>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="FileCountText" Grid.Column="0" VerticalAlignment="Center" Foreground="#FF444444"/>
                <Button Name="RemoveInSyncButton" Grid.Column="1" Content="Remove synced" Width="110" Margin="0,0,10,0"
                        Click="RemoveInSyncButton_Click" IsEnabled="False"/>
                <Button Name="DlinkAllButton" Grid.Column="2" Content="Dlink all" Width="90" Margin="0,0,10,0"
                        Click="DlinkAllButton_Click" IsEnabled="False"/>
                <Button Name="CancelButton" Grid.Column="3" Content="Cancel" Width="90" Click="CancelButton_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
