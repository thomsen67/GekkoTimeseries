<Window x:Class="Gekko.WindowDlink"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create/update .dlink files manually"
        Height="560" Width="880"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- New: compact, slightly rounded style for the per-row [Dlink]/[Remove] buttons. -->
        <Style x:Key="RoundedSmallButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="18"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="#FFF0F0F0"/>
            <Setter Property="BorderBrush" Value="#FFACACAC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <!-- New: without this Margin binding, the Padding setter above had no
                                 visible effect at all; Padding was set on the Button but never
                                 consumed anywhere in the template. -->
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFE5E5E5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FFD0D0D0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Grid Grid.Row="0" Name="DropZone" AllowDrop="True"
              Drop="DropZone_Drop" DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave">
            <Rectangle Name="DropZoneBorder" Fill="#FFF4F4F4" Stroke="#FF999999" StrokeThickness="2"
                       StrokeDashArray="4 2" RadiusX="4" RadiusY="4"/>
            <TextBlock Name="DropZoneHintText" Text="Drag data files or folders here"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                       FontSize="14" Foreground="#FF555555" TextWrapping="Wrap" TextAlignment="Center" Margin="10"/>
        </Grid>
        
        <DataGrid Grid.Row="2" Name="FilesGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                  IsReadOnly="True" SelectionMode="Extended" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#FF999999"
                  AllowDrop="True" Drop="DropZone_Drop" DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave">
            <!-- New: right-click anywhere on a row to copy either path to the clipboard. One
                 shared ContextMenu instance is fine here; WPF reassigns PlacementTarget to
                 whichever row was actually clicked each time it opens. -->
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu>
                                <MenuItem Header="Copy data file path" Click="CopyDataFilePath_Click"/>
                                <MenuItem Header="Copy dlink file path" Click="CopyDlinkFilePath_Click"/>
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>                
                <!-- New: SortMemberPath lets the user click this header to sort by data file path,
                     since DataGrid cannot auto-detect a sort key for a template column. -->
                <DataGridTemplateColumn Header="Path" Width="4*" SortMemberPath="Path" CanUserSort="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical" Margin="2,6,2,6">
                                <!-- New: data file path in a dusted dark blue -->
                                <TextBlock Text="{Binding Path}" Foreground="#FF1F4E79"/>
                                <TextBlock Text="{Binding DlinkPathDisplay}" Foreground="#FF888888"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="3*"/>                
                <DataGridTemplateColumn Header="" Width="135">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Dlink" Style="{StaticResource RoundedSmallButtonStyle}"
                                        Margin="0,0,4,0" Click="DlinkSingleRow_Click" Tag="{Binding}"/>
                                <Button Content="Remove" Style="{StaticResource RoundedSmallButtonStyle}"
                                        Click="RemoveRow_Click" Tag="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        
        <TextBlock Grid.Row="4" Name="OrphanSummaryText" TextWrapping="Wrap" Foreground="#FF8A6D00"
                   Visibility="Collapsed" MaxHeight="120"/>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Name="StatusText" Grid.Column="0" VerticalAlignment="Center" Foreground="#FF444444"/>            
            <Button Name="DlinkAllButton" Grid.Column="1" Content="Dlink all" Width="90" Margin="0,0,10,0"
                    Click="DlinkAllButton_Click" IsEnabled="False"/>
            <Button Name="CancelButton" Grid.Column="2" Content="Cancel" Width="90" Click="CancelButton_Click"/>
        </Grid>
    </Grid>
</Window>
