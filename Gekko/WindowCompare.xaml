<Window x:Class="Gekko.WindowCompare"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Gekko"
        Title="Compare databanks"
        Height="800" Width="1180" MinHeight="640" MinWidth="960"
        Top="20" Left="20"
        Loaded="Window_Loaded" Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown" KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- The pressed button of the Folders | Datafiles switch and of the frequency buttons (white text on it) -->
        <SolidColorBrush x:Key="SelectedStateBrush" Color="#FF888888"/>

        <Style x:Key="RoundedSmallButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="18"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="#FFF0F0F0"/>
            <Setter Property="BorderBrush" Value="#FFACACAC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFE5E5E5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FFD0D0D0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#FFAAAAAA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small borderless icon button (the red X in the list) -->
        <Style x:Key="FlatIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFFBE3E3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The two halves of the Folders | Datafiles switch at the top left. Tag holds the corner radius
             (a Binding rather than TemplateBinding, so the text "3,0,0,3" is converted to a CornerRadius).
             The pressed one is grey (SelectedStateBrush). -->
        <Style x:Key="StateButtonStyle" TargetType="RadioButton">
            <Setter Property="GroupName" Value="CompareState"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FF444444"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Name="Back" Background="#FFF0F0F0" BorderBrush="#FFACACAC" BorderThickness="1"
                                CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Padding="14,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="#FFE5E5E5"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{StaticResource SelectedStateBrush}"/>
                                <Setter TargetName="Back" Property="BorderBrush" Value="{StaticResource SelectedStateBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The frequency buttons at the top of the window, right of the Folders | Datafiles switch (Datafiles only),
             side by side like the switch, with short names (A, Q, M, ...). Created in code; Tag holds the corner
             radius. The pressed one is grey (SelectedStateBrush), like the switch. -->
        <Style x:Key="FreqButtonStyle" TargetType="RadioButton">
            <Setter Property="GroupName" Value="CompareFreq"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#FF444444"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Name="Back" Background="#FFF0F0F0" BorderBrush="#FFACACAC" BorderThickness="1"
                                CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Padding="10,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="#FFE5E5E5"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{StaticResource SelectedStateBrush}"/>
                                <Setter TargetName="Back" Property="BorderBrush" Value="{StaticResource SelectedStateBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The small up/down triangles next to the period boxes -->
        <Style x:Key="SpinButtonStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="#FFF0F0F0"/>
            <Setter Property="BorderBrush" Value="#FFACACAC"/>
            <Setter Property="Delay" Value="400"/>
            <Setter Property="Interval" Value="90"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFE0E0E0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FFC8C8C8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slim rows, like the Databanks window -->
        <Style x:Key="BankRowStyle" TargetType="ListViewItem">
            <Setter Property="Height" Value="25"/>
            <Setter Property="Padding" Value="0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0,0,0,0.5"/>
            <Setter Property="BorderBrush" Value="#FFD8D8D8"/>
            <Setter Property="Opacity" Value="{Binding ItemOpacity}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDragging}" Value="True">
                    <Setter Property="FontWeight" Value="DemiBold"/>
                    <Setter Property="Background" Value="#FFEDEDED"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MonoTextStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="BorderBrush" Value="#FFACACAC"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF444444"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style x:Key="PeriodBoxStyle" TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="BorderBrush" Value="#FFACACAC"/>
        </Style>

        <Style x:Key="PanelLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF444444"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="HintStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF888888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- The check tabs at the bottom of the controls panel: compact headers -->
        <Style x:Key="CheckTabStyle" TargetType="TabItem">
            <Setter Property="Padding" Value="8,1"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10" Name="RootGrid">
        <Grid.RowDefinitions>
            <!-- Its height is saved as CompareWindowSplitterDistance1 -->
            <RowDefinition x:Name="BankListRow" Height="138" MinHeight="76"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top: the Folders | Datafiles switch with the frequency buttons, the drop zone and the numbered,
             reorderable list. -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Compare folders (data files inside) or databanks (series inside). Each keeps its own list.
                 Folders is on the left, but the window starts in the Datafiles state.
                 Then, with a gap, the frequency buttons (Datafiles only; filled in code with the frequencies of the
                 compared databanks), then a line of information. -->
            <DockPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Name="FoldersStateButton" Content="Folders" Style="{StaticResource StateButtonStyle}"
                                 Tag="3,0,0,3" Checked="StateButton_Checked"
                                 ToolTip="Compare the data files in 2 or 3 folders (and their subfolders)"/>
                    <RadioButton Name="DatafilesStateButton" Content="Datafiles" Style="{StaticResource StateButtonStyle}"
                                 Tag="0,3,3,0" Margin="-1,0,0,0" IsChecked="True" Checked="StateButton_Checked"
                                 ToolTip="Compare the series in 2 or 3 databank files"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Left" Name="FreqPanel" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="40,0,0,0"/>
                <TextBlock Name="StateInfoText" Visibility="Collapsed" VerticalAlignment="Center" Margin="24,0,0,0"
                           Foreground="#FF1F4E79" TextTrimming="CharacterEllipsis"/>
            </DockPanel>

            <!-- "Drag datafiles here" (Datafiles) or "Drag folders here" (Folders). While folders are selected, the
                 Datafiles state only shows files opened from the Folders state, and this field is switched off there. -->
            <Grid Grid.Row="2" Grid.Column="0" Name="DropZone" AllowDrop="True"
                  Drop="DropZone_Drop" DragEnter="DropZone_DragEnter" DragOver="DropZone_DragOver" DragLeave="DropZone_DragLeave">
                <Rectangle Name="DropZoneBorder" Fill="#FFF4F4F4" Stroke="#FF999999" StrokeThickness="2"
                           StrokeDashArray="4 2" RadiusX="4" RadiusY="4"/>
                <TextBlock Name="DropZoneHintText" Text="Drag datafiles here"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                           FontSize="14" Foreground="#FF555555" TextWrapping="Wrap" TextAlignment="Center" Margin="10"/>
            </Grid>

            <ListView Grid.Row="2" Grid.Column="2" Name="BankList" SelectionMode="Single" AllowDrop="True"
                      FontFamily="Calibri" FontSize="13" BorderBrush="#FFACACAC"
                      ItemContainerStyle="{StaticResource BankRowStyle}"
                      PreviewMouseLeftButtonDown="BankList_PreviewMouseLeftButtonDown"
                      PreviewMouseMove="BankList_PreviewMouseMove"
                      PreviewKeyDown="BankList_PreviewKeyDown"
                      DragOver="BankList_DragOver" DragLeave="BankList_DragLeave" Drop="BankList_Drop">
                <ListView.Resources>
                    <Style TargetType="GridViewColumnHeader">
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    </Style>
                </ListView.Resources>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="32" Header="">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Width="18" Height="18" CornerRadius="9" Background="{Binding NumberBrush}"
                                            HorizontalAlignment="Left" Visibility="{Binding RowVisibility}"
                                            ToolTip="Drag the row up or down to change the order. The first 2 or 3 are compared.">
                                        <TextBlock Text="{Binding Position}" Foreground="White" FontWeight="Bold"
                                                   FontFamily="Segoe UI" FontSize="11"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="180" Header="Name">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Foreground="#FF1F4E79" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <!-- "Series" for databanks, "Data files" for folders (set in code) -->
                        <GridViewColumn x:Name="ContentsColumn" Width="170" Header="Series" DisplayMemberBinding="{Binding SeriesText}"/>
                        <GridViewColumn Width="330" Header="Full path">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding PathText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                                        <Setter Property="Foreground" Value="#FF999999"/>
                                                        <Setter Property="FontStyle" Value="Italic"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <!-- [Recent] replaces the bank/folder on this row (adds one on the empty row); the red X removes it -->
                        <GridViewColumn Width="96" Header="">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Recent" Style="{StaticResource RoundedSmallButtonStyle}"
                                                FontFamily="Segoe UI" FontSize="11" Padding="8,0"
                                                Click="RowRecent_Click" Tag="{Binding}" ToolTip="{Binding RecentTip}"
                                                Visibility="{Binding RecentVisibility}"/>
                                        <Button Style="{StaticResource FlatIconButtonStyle}" Margin="6,0,0,0"
                                                Click="RemoveBank_Click" Tag="{Binding}" Visibility="{Binding RemoveVisibility}"
                                                ToolTip="Remove from the list (or select the row and press Delete)">
                                            <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="#FFC62828" StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>

        <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="Transparent"
                      ToolTip="Drag to resize the list"/>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="VennRow" Height="1.25*" MinHeight="200"/>
                <RowDefinition x:Name="VennSplitterRow" Height="6"/>
                <!-- Restoring CompareWindowSplitterDistance2 sets this row's share -->
                <RowDefinition x:Name="DetailsRow" Height="*" MinHeight="150"/>
            </Grid.RowDefinitions>

            <!-- Venn diagram on the left, controls on the right. "Hide controls" hides both. -->
            <Grid Grid.Row="0" Name="DiagramArea">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- The diagram -->
                <Border Grid.Column="0" BorderBrush="#FFD5D5D5" BorderThickness="1" CornerRadius="4" Background="White">
                    <local:VennView x:Name="Venn" Margin="8"/>
                </Border>

                <!-- Scrolls when the controls do not fit -->
                <Border Grid.Column="2" Name="ControlsPanel" BorderBrush="#FFD5D5D5" BorderThickness="1" CornerRadius="4"
                        Background="#FFFAFAFA" Width="290">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <Grid Name="ControlsContent" Margin="10,8" VerticalAlignment="Top" Grid.IsSharedSizeScope="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="PanelLabel"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Compare" Style="{StaticResource PanelLabelStyle}"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                            <RadioButton Name="Compare2Radio" Content="first 2" GroupName="CompareMode" VerticalAlignment="Center"
                                         Margin="0,0,12,0" Checked="CompareMode_Changed"/>
                            <RadioButton Name="Compare3Radio" Content="first 3" GroupName="CompareMode" VerticalAlignment="Center"
                                         IsChecked="True" Checked="CompareMode_Changed"/>
                        </StackPanel>

                        <!-- The period, in any frequency: it applies to all frequencies, in both states (e.g. 2010 is
                             2010q1-2010q4 for quarterly series). Everything in this panel is shared by both states. -->
                        <Grid Grid.Row="1" Grid.ColumnSpan="2" Name="PeriodControls">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="PanelLabel"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Period" Style="{StaticResource PanelLabelStyle}"
                                       ToolTip="The period filter, in any frequency (e.g. 2010, 2010q3 or 2010m7). It applies to all frequencies, for databanks and folders. Clicking a histogram bar sets it too."/>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                <Grid Name="FromSpinner" Width="80" Height="18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBox Name="FromBox" Grid.RowSpan="2" Style="{StaticResource PeriodBoxStyle}"
                                             PreviewKeyDown="PeriodBox_PreviewKeyDown" LostKeyboardFocus="PeriodBox_LostKeyboardFocus"
                                             PreviewMouseWheel="PeriodBox_PreviewMouseWheel"
                                             ToolTip="First period, in any frequency: type e.g. 2010 or 2010q1 and press Enter, or step with the arrows, Up/Down or the mouse wheel. Grey: from the start."/>
                                    <RepeatButton Grid.Column="1" Grid.Row="0" Style="{StaticResource SpinButtonStyle}" BorderThickness="0,1,1,0"
                                                  Tag="FromUp" Click="SpinButton_Click" ToolTip="Next period">
                                        <Path Data="M0,3.5 L3,0 L6,3.5 Z" Fill="#FF555555"/>
                                    </RepeatButton>
                                    <RepeatButton Grid.Column="1" Grid.Row="1" Style="{StaticResource SpinButtonStyle}" BorderThickness="0,1,1,1"
                                                  Tag="FromDown" Click="SpinButton_Click" ToolTip="Previous period">
                                        <Path Data="M0,0 L6,0 L3,3.5 Z" Fill="#FF555555"/>
                                    </RepeatButton>
                                </Grid>
                                <TextBlock Text="to" Foreground="#FF444444" VerticalAlignment="Center" Margin="6,0,6,0"/>
                                <Grid Name="ToSpinner" Width="80" Height="18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBox Name="ToBox" Grid.RowSpan="2" Style="{StaticResource PeriodBoxStyle}"
                                             PreviewKeyDown="PeriodBox_PreviewKeyDown" LostKeyboardFocus="PeriodBox_LostKeyboardFocus"
                                             PreviewMouseWheel="PeriodBox_PreviewMouseWheel"
                                             ToolTip="Last period, in any frequency: type e.g. 2020 or 2020q4 and press Enter, or step with the arrows, Up/Down or the mouse wheel. Grey: to the end."/>
                                    <RepeatButton Grid.Column="1" Grid.Row="0" Style="{StaticResource SpinButtonStyle}" BorderThickness="0,1,1,0"
                                                  Tag="ToUp" Click="SpinButton_Click" ToolTip="Next period">
                                        <Path Data="M0,3.5 L3,0 L6,3.5 Z" Fill="#FF555555"/>
                                    </RepeatButton>
                                    <RepeatButton Grid.Column="1" Grid.Row="1" Style="{StaticResource SpinButtonStyle}" BorderThickness="0,1,1,1"
                                                  Tag="ToDown" Click="SpinButton_Click" ToolTip="Previous period">
                                        <Path Data="M0,0 L6,0 L3,3.5 Z" Fill="#FF555555"/>
                                    </RepeatButton>
                                </Grid>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.Column="1" Name="SpanText" Style="{StaticResource HintStyle}" Margin="0,3,0,3"/>
                            <Button Grid.Row="2" Grid.Column="1" Name="WholePeriodButton" Content="Whole period"
                                    Style="{StaticResource RoundedSmallButtonStyle}" HorizontalAlignment="Left"
                                    Margin="0,0,0,10" Click="WholePeriod_Click"
                                    ToolTip="Remove the period filter: all periods"/>
                        </Grid>

                        <TextBlock Grid.Row="3" Text="Filter" Style="{StaticResource PanelLabelStyle}"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Name="FilterBox" Height="22" VerticalContentAlignment="Center"
                                 TextChanged="FilterBox_TextChanged"
                                 ToolTip="Datafiles: only these series are compared. Folders: only these data files are compared."/>
                        <CheckBox Grid.Row="4" Grid.Column="1" Name="RegexCheck" Content="Regex" Margin="0,5,0,0"
                                  Checked="RegexCheck_Changed" Unchecked="RegexCheck_Changed"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Name="FilterHint" Style="{StaticResource HintStyle}"
                                   Text="Wildcards * and ?, several patterns separated by spaces" Margin="0,4,0,8"/>

                        <!-- The check, shared by both states. The red numbers, the histogram, the red names/files and the *
                             in Values follow it. In the Folders state it is applied to the series inside each data file. -->
                        <TabControl Grid.Row="6" Grid.ColumnSpan="2" Name="CheckTabs" SelectionChanged="CheckTabs_SelectionChanged"
                                    Background="White">
                            <TabItem Header="Differences" Name="DifferencesCheckTab" Style="{StaticResource CheckTabStyle}"
                                     ToolTip="Find series whose values differ between the banks">
                                <StackPanel Margin="4,5,4,4">
                                    <StackPanel Name="DiffThresholdPanel">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Threshold" Style="{StaticResource LabelStyle}"/>
                                            <TextBox Name="DiffThresholdBox" Width="70" Height="20" Text="0" VerticalContentAlignment="Center"
                                                     TextChanged="Threshold_Changed"
                                                     ToolTip="Two values are equal when they differ by at most this much (0: exactly equal)"/>
                                            <CheckBox Name="DiffRelativeCheck" Content="relative (%)" VerticalAlignment="Center" Margin="10,0,0,0"
                                                      Checked="Threshold_Changed" Unchecked="Threshold_Changed"
                                                      ToolTip="The threshold is in percent of the larger of the two values"/>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource HintStyle}" Margin="0,5,0,0"
                                                   Text="Values differing by more than the threshold, or a value against M, differ. M against M is equal."/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource HintStyle}" Margin="0,4,0,0"
                                               Text="Folders: a file differs when, in some frequency, its copies do not have the same series, or a series differs in the period."/>
                                </StackPanel>
                            </TabItem>
                            <TabItem Header="Missings" Name="MissingsCheckTab" Style="{StaticResource CheckTabStyle}"
                                     ToolTip="Find series with missing values (M)">
                                <TextBlock Margin="4,5,4,4" Style="{StaticResource HintStyle}"
                                           Text="Series (or data files) with M (missing) in at least one of the banks/folders of the area. For a whole bank or folder (its box): M in that one."/>
                            </TabItem>
                            <TabItem Header="Zeroes" Name="ZeroesCheckTab" Style="{StaticResource CheckTabStyle}"
                                     ToolTip="Find series with zeroes">
                                <StackPanel Margin="4,5,4,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Threshold" Style="{StaticResource LabelStyle}"/>
                                        <TextBox Name="ZeroThresholdBox" Width="70" Height="20" Text="0" VerticalContentAlignment="Center"
                                                 TextChanged="Threshold_Changed"
                                                 ToolTip="A value counts as zero when its absolute value is at most this (0: exactly zero)"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource HintStyle}" Margin="0,5,0,0"
                                               Text="Series (or data files) with a zero (|value| ≤ threshold) in at least one of the banks/folders of the area. For a whole bank or folder: in that one."/>
                                </StackPanel>
                            </TabItem>
                        </TabControl>
                    </Grid>
                    </ScrollViewer>
                </Border>
            </Grid>

            <GridSplitter Grid.Row="1" Name="VennSplitter" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="Transparent"/>

            <!-- Details. The toggle button sits to the right of the tab headers. -->
            <Grid Grid.Row="2">
                <TabControl Name="Tabs" SelectionChanged="Tabs_SelectionChanged">
                    <!-- "Names" (Datafiles) or "Files" (Folders); the header is set in code -->
                    <TabItem Header="Names" Name="NamesTab"
                             ToolTip="Datafiles: click a name to see its values. Drag over names to select them (whole names only); right-click to plot them.">
                        <Grid Margin="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="4"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Name="NamesHeader" Foreground="#FF444444" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <CheckBox Grid.Column="1" Name="IgnoreDimsCheck" Content="Ignore dimensions"
                                          VerticalAlignment="Center" Margin="10,0,12,0"
                                          ToolTip="List x[a,b] and x[a,c] as just x"
                                          Checked="IgnoreDims_Changed" Unchecked="IgnoreDims_Changed"/>
                                <Button Grid.Column="2" Content="Copy" Style="{StaticResource RoundedSmallButtonStyle}"
                                        Click="CopyNames_Click"/>
                            </Grid>
                            <!-- Datafiles: the names, comma-separated; found ones in dark red, the commas black. A name under
                                 the mouse is underlined like a link; click it: its values. A selection always covers whole
                                 names; right-click: Plot (the context menu is made in code). -->
                            <RichTextBox Grid.Row="2" Name="NamesText" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                         FontFamily="Consolas" FontSize="12.5" BorderBrush="#FFACACAC" Padding="4,2"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                         IsInactiveSelectionHighlightEnabled="True"
                                         PreviewMouseMove="NamesText_PreviewMouseMove" MouseLeave="NamesText_MouseLeave"
                                         ScrollViewer.ScrollChanged="NamesText_ScrollChanged"
                                         PreviewMouseLeftButtonDown="NamesText_PreviewMouseLeftButtonDown"
                                         PreviewMouseLeftButtonUp="NamesText_PreviewMouseLeftButtonUp"
                                         PreviewMouseRightButtonDown="NamesText_PreviewMouseRightButtonDown"
                                         ContextMenuOpening="NamesText_ContextMenuOpening"/>
                            <!-- New, Folders: one file per line; differing ones in dark red; click a file to compare its series -->
                            <ListBox Grid.Row="2" Name="FilesList" Visibility="Collapsed" BorderBrush="#FFACACAC"
                                     FontFamily="Consolas" FontSize="12.5"
                                     VirtualizingStackPanel.IsVirtualizing="True"
                                     PreviewMouseLeftButtonDown="FilesList_PreviewMouseLeftButtonDown"
                                     MouseLeftButtonUp="FilesList_MouseLeftButtonUp" KeyDown="FilesList_KeyDown">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}" Foreground="{Binding Foreground}"
                                                   ToolTip="{Binding Tip}" Cursor="{Binding Cursor}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>

                    <!-- Per period, the number of series found by the current check (Datafiles) -->
                    <TabItem Header="Histogram" Name="HistogramTab"
                             ToolTip="Per period, for the selected area: the series found by the check. Click a bar to filter on that period; double-click to list the names.">
                        <local:HistogramView x:Name="Histogram" Margin="4"/>
                    </TabItem>

                    <!-- "Values" (Datafiles): all series of the Names list in one text; Previous/Next jump between them.
                         "Details" (Folders): steps through the files in the Files list. -->
                    <TabItem Header="Values" Name="ValuesTab">
                        <Grid Margin="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="4"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Name="PrevButton" Grid.Column="0" Content="&#x25B2; Previous"
                                        Style="{StaticResource RoundedSmallButtonStyle}" Click="PrevButton_Click"
                                        ToolTip="Jump to the previous series (Ctrl+Up)"/>
                                <Button Name="NextButton" Grid.Column="1" Content="&#x25BC; Next" Margin="6,0,0,0"
                                        Style="{StaticResource RoundedSmallButtonStyle}" Click="NextButton_Click"
                                        ToolTip="Jump to the next series (Ctrl+Down)"/>
                                <TextBlock Name="NavText" Grid.Column="2" Margin="12,0,0,0" FontWeight="SemiBold"
                                           Foreground="#FF1F4E79" VerticalAlignment="Center"/>
                                <TextBlock Name="LegendText" Grid.Column="3" Margin="16,0,8,0" Foreground="#FF888888"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <CheckBox Name="OnlyFoundCheck" Grid.Column="4" Content="Only periods marked *"
                                          VerticalAlignment="Center" ToolTip="Only the periods found by the current check"
                                          Checked="OnlyFound_Changed" Unchecked="OnlyFound_Changed"/>
                            </Grid>
                            <TextBox Grid.Row="2" Name="DevText" Style="{StaticResource MonoTextStyle}"
                                     TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                     IsInactiveSelectionHighlightEnabled="True"
                                     ScrollViewer.ScrollChanged="DevText_ScrollChanged" IsVisibleChanged="DevText_IsVisibleChanged"/>
                        </Grid>
                    </TabItem>
                </TabControl>
                <Button Name="DiagramToggle" Content="&#x25B4; Hide controls" Style="{StaticResource RoundedSmallButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0" Click="DiagramToggle_Click"
                        ToolTip="Hide the diagram and controls to give the tabs more room (Ctrl+D)"/>
            </Grid>
        </Grid>

        <!-- Status -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Name="StatusText" Foreground="#FF444444" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="1" Content="Close" Width="90" Click="CloseButton_Click"/>
        </Grid>
    </Grid>
</Window>
