<Window x:Class="Gekko.WindowBankCompare"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Gekko"
        Title="Compare databanks"
        Height="760" Width="1180" MinHeight="700" MinWidth="960"
        Top="20" Left="20"        
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="RoundedSmallButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="18"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="#FFF0F0F0"/>
            <Setter Property="BorderBrush" Value="#FFACACAC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFE5E5E5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FFD0D0D0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#FFAAAAAA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MonoTextStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="BorderBrush" Value="#FFACACAC"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF444444"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="130"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="1.25*" MinHeight="260"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="*" MinHeight="180"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Drop zone and numbered, reorderable list of banks -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Name="DropZone" AllowDrop="True"
                  Drop="DropZone_Drop" DragEnter="DropZone_DragEnter" DragOver="DropZone_DragOver" DragLeave="DropZone_DragLeave">
                <Rectangle Name="DropZoneBorder" Fill="#FFF4F4F4" Stroke="#FF999999" StrokeThickness="2"
                           StrokeDashArray="4 2" RadiusX="4" RadiusY="4"/>
                <TextBlock Name="DropZoneHintText" Text="Drag databank files here"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                           FontSize="14" Foreground="#FF555555" TextWrapping="Wrap" TextAlignment="Center" Margin="10"/>
            </Grid>

            <ListBox Grid.Column="2" Name="BankList" HorizontalContentAlignment="Stretch" AllowDrop="True"
                     BorderBrush="#FFACACAC" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     PreviewMouseLeftButtonDown="BankList_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="BankList_PreviewMouseMove"
                     DragOver="BankList_DragOver" Drop="BankList_Drop"
                     ToolTip="Drag a bank up or down to change the order. The first two or three are compared.">
                <ListBox.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FFE3E3E3"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FFEAEAEA"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="Black"/>
                </ListBox.Resources>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,3" Opacity="{Binding ItemOpacity}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="22" Height="22" CornerRadius="11" Background="{Binding BadgeBrush}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Position}" Foreground="White" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" Foreground="#FF1F4E79"/>
                                <TextBlock Text="{Binding Info}" Foreground="#FF888888" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="Remove" Style="{StaticResource RoundedSmallButtonStyle}"
                                    VerticalAlignment="Center" Click="RemoveBank_Click" Tag="{Binding}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Controls -->
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <TextBlock Text="Compare" Style="{StaticResource LabelStyle}"/>
            <RadioButton Name="Compare2Radio" Content="first 2" GroupName="CompareMode" VerticalAlignment="Center"
                         Margin="0,0,10,0" Checked="CompareMode_Changed"/>
            <RadioButton Name="Compare3Radio" Content="first 3" GroupName="CompareMode" VerticalAlignment="Center"
                         Margin="0,0,26,0" IsChecked="True" Checked="CompareMode_Changed"/>

            <TextBlock Text="Frequency" Style="{StaticResource LabelStyle}"/>
            <ComboBox Name="FreqCombo" Width="110" VerticalAlignment="Center" Margin="0,0,26,0"
                      SelectionChanged="FreqCombo_SelectionChanged"/>

            <TextBlock Text="Filter" Style="{StaticResource LabelStyle}"/>
            <TextBox Name="FilterBox" Width="230" Height="22" VerticalContentAlignment="Center"
                     TextChanged="FilterBox_TextChanged"/>
            <CheckBox Name="RegexCheck" Content="Regex" VerticalAlignment="Center" Margin="10,0,0,0"
                      Checked="RegexCheck_Changed" Unchecked="RegexCheck_Changed"/>
            <TextBlock Name="FilterHint" Text="Wildcards * and ?, several patterns separated by spaces"
                       Foreground="#FF888888" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>

        <!-- Venn diagram -->
        <Border Grid.Row="4" BorderBrush="#FFD5D5D5" BorderThickness="1" CornerRadius="4" Background="White">
            <local:VennView x:Name="Venn" Margin="8"/>
        </Border>

        <GridSplitter Grid.Row="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="Transparent"/>

        <!-- Details -->
        <TabControl Grid.Row="6" Name="Tabs">
            <TabItem Header="Names" Name="NamesTab">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Name="NamesHeader" Foreground="#FF444444" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <CheckBox Grid.Column="1" Name="IgnoreDimsCheck" Content="Ignore dimensions"
                                  VerticalAlignment="Center" Margin="10,0,12,0"
                                  ToolTip="List x[a,b] and x[a,c] as just x"
                                  Checked="IgnoreDims_Changed" Unchecked="IgnoreDims_Changed"/>
                        <Button Grid.Column="2" Content="Copy" Style="{StaticResource RoundedSmallButtonStyle}"
                                Click="CopyNames_Click"/>
                    </Grid>
                    <TextBox Grid.Row="2" Name="NamesText" Style="{StaticResource MonoTextStyle}"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </TabItem>

            <TabItem Header="Histogram" Name="HistogramTab">
                <local:HistogramView x:Name="Histogram" Margin="4"/>
            </TabItem>

            <TabItem Header="Deviations" Name="DeviationsTab">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Name="PrevButton" Grid.Column="0" Content="&#x25B2; Previous"
                                Style="{StaticResource RoundedSmallButtonStyle}" Click="PrevButton_Click"
                                ToolTip="Previous series (Ctrl+Up)"/>
                        <Button Name="NextButton" Grid.Column="1" Content="&#x25BC; Next" Margin="6,0,0,0"
                                Style="{StaticResource RoundedSmallButtonStyle}" Click="NextButton_Click"
                                ToolTip="Next series (Ctrl+Down)"/>
                        <TextBlock Name="NavText" Grid.Column="2" Margin="12,0,0,0" FontWeight="SemiBold"
                                   Foreground="#FF1F4E79" VerticalAlignment="Center"/>
                        <TextBlock Name="LegendText" Grid.Column="3" Margin="16,0,8,0" Foreground="#FF888888"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <CheckBox Name="OnlyDevCheck" Grid.Column="4" Content="Deviating periods only"
                                  VerticalAlignment="Center"
                                  Checked="OnlyDev_Changed" Unchecked="OnlyDev_Changed"/>
                    </Grid>
                    <TextBox Grid.Row="2" Name="DevText" Style="{StaticResource MonoTextStyle}"
                             TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                             IsInactiveSelectionHighlightEnabled="True"/>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status -->
        <Grid Grid.Row="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Name="StatusText" Foreground="#FF444444" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="1" Content="Close" Width="90" Click="CloseButton_Click"/>
        </Grid>
    </Grid>
</Window>

