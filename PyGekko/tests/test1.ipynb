   "source": [
    "import pygekko as pg\n",
    "t1 = 2021\n",
    "t2 = 2023\n",
    "pg.run(\"reset;\")\n",
    "pg.run(f\"time {t1} {t2};\")\n",
    "pg.run(\"x1 = 2, 3, 4;\")\n",
    "pg.run(\"x2 = 7, 5, 6;\")\n",
    "pg.run(\"y = x1 + x2;\")\n",
    "pg.run(\"prt x1, x2, x1/y;\")"
   ]
  }
